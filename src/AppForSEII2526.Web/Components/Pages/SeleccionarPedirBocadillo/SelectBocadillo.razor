@page "/PedirBocadillo/SelectBocadilloParaPedir"

@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBocadillo> logger
@inject CompraBocadilloStateContainer compraState
@inject NavigationManager navigation


<h3>Select Bocadillo Para Pedir</h3>
<div class="container-fluid">
    <div class="row">
        <p>Aquí se muestran los errores</p>
    </div>
    <div class="row" hidden="@hideErrors">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tamaño</span>
                        <input type="text" id="inputTamaño" @bind=tamaño class="form-control" placeholder="Tamaño" aria-label="Tamaño" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tipo Pan</span>
                        
                        <select class="form-select" aria-label="Default select" @bind="TipoPanSelected" id="selectTipoPan">
                            <option value="All" selected>All</option>
                            @foreach (string tipoPanName in tipoPanNames)
                            {
                                <option value="@tipoPanName" id="tipoPanSelected_@tipoPanName">@tipoPanName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarBocadillos id="BuscarBocadillos">Buscar bocadillos</button>
                </div>
            </div>
            <div class="row">
                @if (bocadillos == null)
                {
                    <p>Loading bocadillos....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tamaño</th>
                                    <th>Tipo Pan</th>
                                    <th>PVP</th>
                                    <th>Comprar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bocadillo in bocadillos)
                                {
                                    <tr id="BocadilloData_@bocadillo.Nombre">
                                        <td>@bocadillo.Nombre</td>
                                        <td>@bocadillo.Tamaño</td>
                                        <td>@bocadillo.TipoPanNombre</td>
                                        <td>@bocadillo.Pvp</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="bocadilloParaComprar_@bocadillo.Nombre" @onclick="@(() => AddBocadillo(bocadillo))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-2" hidden="@hideRentingCart">
            <div class="row">
                <h3>Shopping Cart</h3>
            </div>
            @foreach (ArticuloPedidoDTO item in compra.ArticuloPedido)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeBocadillo_@item.NombreBocadillo" @onclick="@(() => RemoveRentalItem(item))">x @item.NombreBocadillo - @item.Pvp€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="purchaseBocadilloButton" @onclick=@CompraBocadillo>Compra Bocadillo</button>
            </div>
        </div>
    </div>
</div>

@code {
    private ICollection<BocadilloDTO> bocadillos;
    private bool hideErrors { get { return errors.Length == 0; } }

    private string errors = "";
    private Tamaño tamaño { get; set; }
    private string tipoPan { get; set; }

    private string TipoPanSelected;
    private ICollection<string>? tipoPanNames = new List<string>();

    private bool hideRentingCart { get { return compra.ArticuloPedido.Count == 0; } }

    public async void BuscarBocadillos()
    {
        try
        {
            bocadillos = await apiclient.GetBocadillosParaPedirAsync(tamaño, tipoPan);

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    private CrearPedidoDTO compra => compraState.Compra;

    private bool hiddenRentingCart = true;

    private void AddBocadillo(BocadilloDTO bocadillo)
    {
        compraState.AddBocadilloParaComprar(bocadillo);
    }

    private void RemoveRentalItem(ArticuloPedidoDTO articulo)
    {
        compraState.RemoveCompraArticuloParaComprar(articulo);
        if (compra.ArticuloPedido.Count == 0) hiddenRentingCart = true;
    }


    protected override Task OnInitializedAsync()
    {
        try
        {
            tipoPanNames = await apiclient.GetTipoPanesAsync(null);
        }
        catch (ApiException ex)
        {
            if (tipoPanNames == null) tipoPanNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetGenresAsync service");
        }

        BuscarBocadillos();

        //return base.OnInitializedAsync();
    }
    private void CompraBocadillo()
    {
        navigation.NavigateTo("/SeleccionarPedirBocadillo/CrearPedido");
    }
}
