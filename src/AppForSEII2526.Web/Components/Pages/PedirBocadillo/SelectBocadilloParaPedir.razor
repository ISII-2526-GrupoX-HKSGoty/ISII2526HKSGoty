@page "/PedirBocadillo/SelectBocadilloParaPedir"

@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBocadilloParaPedir> logger
@inject CompraBocadilloStateContainercs compraState
@inject NavigationManager navigation


<h3>Select Bocadillo Para Pedir</h3>
<div class="container-fluid">
    <div class="row">
        <p>Aquí se muestran los errores</p>
    </div>
    <div class="row" hidden="@hideErrors">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tamaño</span>
                        <input type="text" id="inputTitle" @bind=tamaño class="form-control" placeholder="Tamaño" aria-label="Tamaño" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tipo Pan</span>
                        <input type="text" id="inputPan" @bind=TipoPan class="form-control" placeholder="Tipo Pan" aria-label="Tipo Pan" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">From</span>
                        <InputDate @bind-Value="@From" id="fromDate" />
                    </div>
                </div>
                <div class="col">
                    <span class="input-group-text">To</span>
                    <InputDate id="toDate" @bind-Value="@To" />

                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchBocadillo id="searchBocadillo">Search Bocadillo</button>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchMovies id="searchMovies">Search movies</button>
                </div>
            </div>
        </div>
        <div class="col-2">
            <p>Aquí se muestra el carrito de compra</p>
        </div>
    </div>
</div>
@code {
    private ICollection<BocadilloDTO> bocadillos;
    private bool hideErrors { get { return errors.Length == 0; } }

    private string errors = "";
    private Tamaño tamaño { get; set; }
    private string tipoPan { get; set; }

    private string TipoPanSelected;
    private ICollection<string>? tipoPanNames = new List<string>();

    private bool hideRentingCart { get { return compra.ItemPedido.Count == 0; } }

    public async void BuscarBocadillos()
    {
        try
        {
            bocadillos = await apiclient.GetBocadillosParaPedirAsync(tamaño, tipoPan);

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    private CrearPedidoDTO compra => compraState.Compra;

    private bool hiddenRentingCart = true;

    private void AddBocadillo(BocadilloDTO bocadillo)
    {
        compraState.AddBocadilloToComprar(bocadillo);
    }

    private void RemoveRentalItem(ArticuloPedidoDTO articulo)
    {
        compraState.RemoveCompralItemToRent(articulo);
        if (compra.ItemPedido.Count == 0) hiddenRentingCart = true;
    }


    protected override Task OnInitializedAsync()
    {
        try
        {
            tipoPanNames = await apiclient.GetTipoPanesAsync(null);
        }
        catch (ApiException ex)
        {
            if (tipoPanNames == null) tipoPanNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetGenresAsync service");
        }

        BuscarBocadillos();

        //return base.OnInitializedAsync();
    }
}
